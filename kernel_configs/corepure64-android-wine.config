# ==============================================================================
# Linux Kernel 6.14+ LTS Config Fragment — CorePure64 + x86 Dual-Arch
# Integrates Wine 10+ (/dev/ntsync + IA32_EMULATION), Android (Binder/BinderFS),
# and binfmt_misc direct binary execution directly into the kernel (=y).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dual x86 / x86_64 Execution & Wine 10+ WoW64 Support
# ------------------------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_IA32_EMULATION=y
CONFIG_X86_X32_ABI=y
CONFIG_COMPAT=y
CONFIG_BINFMT_ELF=y
CONFIG_COMPAT_BINFMT_ELF=y
CONFIG_BINFMT_MISC=y
CONFIG_NTSYNC=y
CONFIG_USER_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ------------------------------------------------------------------------------
# 2. Direct Android Container & APK Execution (Built-in =y)
# ------------------------------------------------------------------------------
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_MEMFD_CREATE=y
CONFIG_PSI=y
CONFIG_STAGING=y

# ------------------------------------------------------------------------------
# 3. Namespaces, Cgroups, SquashFS & OverlayFS
# ------------------------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y

# ------------------------------------------------------------------------------
# 4. Virtualization, Networking & Graphics
# ------------------------------------------------------------------------------
CONFIG_KVM=y
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VIRTIO_GPU=y
